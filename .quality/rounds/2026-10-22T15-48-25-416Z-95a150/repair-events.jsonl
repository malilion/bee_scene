roughness:0.91,side:THREE.DoubleSide});\n        const unopened=new THREE.InstancedMesh(tubularFloret(false),mat,buds);\n        const flowering=new THREE.InstancedMesh(tubularFloret(true),mat,total-buds);\n        const dummy=new THREE.Object3D(),color=new THREE.Color();\n        const supportCells=new Map(),cellSize=0.028*scale;\n        headGroup.userData.floretSupport={cells:supportCells,cellSize};\n        for(let i=0;i<total;i++) {\n          const t=(i+0.5)/total,r=Math.sqrt(t)*coreRadius*(0.978+(Math.random()-0.5)*0.012);\n          const theta=i*2.3999632297+(Math.random()-0.5)*0.021;\n          dummy.position.set(Math.cos(theta)*r,discHeight(coreRadius,coreHeight,r,species)+0.002*scale,Math.sin(theta)*r);\n          dummy.rotation.set((Math.random()-0.5)*0.2,theta,(Math.random()-0.5)*0.2);\n          dummy.scale.set(0.85+Math.random()*0.35,0.6+Math.random()*0.65,0.85+Math.random()*0.35);\n          dummy.updateMatrix();\n          const mesh=i<buds?unopened:flowering,k=i<buds?i:i-buds;\n          mesh.setMatrixAt(k,dummy.matrix);\n          if(i<buds) {\n            color.lerpColors(new THREE.Color(0x35251b),new THREE.Color(0x8c7133),Math.pow(t/(buds/total),2.1));\n            const key=Math.floor(dummy.position.x/cellSize)+','+Math.floor(dummy.position.z/cellSize);\n            if(!supportCells.has(key))supportCells.set(key,[]);\n            supportCells.get(key).push({x:dummy.position.x,z:dummy.position.z,y:dummy.position.y+0.006*scale*dummy.scale.y,\n              rx:0.0095*scale*dummy.scale.x,rz:0.0095*scale*dummy.scale.z,ry:0.008075*scale*dummy.scale.y});\n          } else color.lerpColors(new THREE.Color(0x9d7720),new THREE.Color(0xeac34b),(t-buds/total)/(1-buds/total));\n          color.multiplyScalar(0.82+Math.random()*0.32);mesh.setColorAt(k,color);\n        }\n        // Anther columns and granular pollen emerge only from the flowering annulus.\n        const anthers=new THREE.InstancedMesh(new THREE.CylinderGeometry(0.0025*scale,0.0032*scale,0.0